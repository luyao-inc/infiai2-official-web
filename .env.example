# 可选：在 Caddyfile 顶部的 { } 中取消注释并填写 email，便于 Let's Encrypt 到期邮件提醒

# Docker 开发（docker-compose.dev.yml）默认端口，避免与 5173/3003/18080 冲突
# OFFICIAL_WEB_DEV_PORT=5188

# 必填：在 .env.local 中配置当前环境的公开客服 Widget ID 和 Chat 地址。
# 不提交实际 ID；Docker 构建通过 build args 显式传递，不依赖 .env.local。
VITE_WEBSITE_WIDGET_ID=
VITE_WEBSITE_WIDGET_API_BASE=http://127.0.0.1:10008
